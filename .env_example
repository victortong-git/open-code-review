# Remove this file to .env and fill in your API keys and LLM configuration.
# Configure your preferred LLM provider by setting LLM_PROVIDER and the corresponding settings.

# LLM Provider Selection
LLM_PROVIDER=openai  # Options: openai, nvidia, ollama

# OpenAI Configuration
OPENAI_API_KEY="[your_openai_api_key_here]"
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# NVIDIA Configuration  
NVIDIA_API_KEY="[your_nvidia_api_key_here]"
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama Configuration
OLLAMA_URL=http://192.168.3.93
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_KEY=EMPTY

# LLM General Settings
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
